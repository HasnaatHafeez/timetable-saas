generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SYSTEM_ADMIN
  INSTITUTION_OWNER
  STAFF_ADMIN
  TEACHER
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
}

enum SubjectType {
  THEORY
  LAB
}

enum RoomType {
  CLASSROOM
  LAB
}

enum TimetableStatus {
  DRAFT
  LOCKED
}

model User {
  id        String @id @default(uuid())
  name      String
  email     String @unique
  password  String
  role      Role
  isActive  Boolean @default(true)

  staffs    Staff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Institution {
  id        String @id @default(uuid())
  name      String
  type      InstitutionType
  ownerId   String

  campuses  Campus[]
  staffs    Staff[]
  timetableGenerationSettings TimetableGenerationSetting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campus {
  id            String @id @default(uuid())
  institutionId String
  name          String
  location      String

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  departments   Department[]
  teachers      Teacher[]
  rooms         Room[]
  timeSlots     TimeSlot[]
  workingDays   WorkingDay[]
  holidays      Holiday[]
  academicLevels AcademicLevel[]
  staffs        Staff[]
  staffCampusLinks StaffCampus[]

  createdAt DateTime @default(now())
}

model AcademicLevel {
  id       String @id @default(uuid())
  campusId String
  name     String

  campus   Campus @relation(fields: [campusId], references: [id])
  sections Section[]
}

model Section {
  id              String @id @default(uuid())
  academicLevelId String
  name            String
  sectionCode     String?

  academicLevel   AcademicLevel @relation(fields: [academicLevelId], references: [id])
  sectionSubjects SectionSubject[]
}

model Department {
  id       String @id @default(uuid())
  campusId String
  name     String
  campus   Campus @relation(fields: [campusId], references: [id])
  subjects Subject[]
}

model Subject {
  id           String @id @default(uuid())
  departmentId String
  name         String
  type         SubjectType
  weeklyHours  Int

  department   Department @relation(fields: [departmentId], references: [id])
  teacherSubjects TeacherSubject[]
  sectionSubjects SectionSubject[]
  timetables   Timetable[]
}

model SectionSubject {
  id         String @id @default(uuid())
  sectionId  String
  subjectId  String

  section    Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([sectionId, subjectId])
}

model Teacher {
  id         String @id @default(uuid())
  name       String
  email      String
  phone      String?
  campusId   String
  maxPerDay  Int
  maxPerWeek Int

  campus     Campus @relation(fields: [campusId], references: [id])

  teacherSubjects TeacherSubject[]
  teacherAvailability TeacherAvailability[]
  timetables  Timetable[]
}

model Staff {
  id            String @id @default(uuid())
  userId        String
  institutionId String
  campusId      String?

  user         User        @relation(fields: [userId], references: [id])
  institution  Institution @relation(fields: [institutionId], references: [id])
  campus       Campus?     @relation(fields: [campusId], references: [id])
  campusLinks  StaffCampus[]

  createdAt DateTime @default(now())
}

model StaffCampus {
  id       String @id @default(uuid())
  staffId  String
  campusId String

  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([staffId, campusId])
}
model TeacherAvailability {
  id         String  @id @default(uuid())
  teacherId  String
  dayId      String
  timeSlotId String
  isAvailable Boolean @default(true)

  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  day        WorkingDay @relation(fields: [dayId], references: [id])
  timeSlot   TimeSlot   @relation(fields: [timeSlotId], references: [id])

  @@unique([teacherId, dayId, timeSlotId])
}
model Room {
  id       String @id @default(uuid())
  campusId String
  name     String
  type     RoomType
  capacity Int

  campus   Campus @relation(fields: [campusId], references: [id])
  timetables Timetable[]
}

model TimeSlot {
  id        String @id @default(uuid())
  campusId  String
  startTime String
  endTime   String
  isBreak   Boolean @default(false)

  teacherAvailability TeacherAvailability[]
  timetables Timetable[]

  campus   Campus @relation(fields: [campusId], references: [id])
}

model WorkingDay {
  id       String @id @default(uuid())
  campusId String
  dayName  String

  teacherAvailability TeacherAvailability[]
  timetables Timetable[]

  campus   Campus @relation(fields: [campusId], references: [id])
}

model Holiday {
  id       String   @id @default(uuid())
  campusId String
  date     DateTime
  name     String

  campus   Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([campusId, date])
}

model Timetable {
  id              String @id @default(uuid())
  campusId        String
  academicLevelId String
  sectionId       String
  subjectId       String
  teacherId       String
  roomId          String
  dayId           String
  timeSlotId      String
  status          TimetableStatus

  subject    Subject    @relation(fields: [subjectId], references: [id])
  teacher    Teacher    @relation(fields: [teacherId], references: [id])
  room       Room       @relation(fields: [roomId], references: [id])
  day        WorkingDay @relation(fields: [dayId], references: [id])
  timeSlot   TimeSlot   @relation(fields: [timeSlotId], references: [id])

  createdAt DateTime @default(now())
}

model TimetableGenerationSetting {
  id                      String          @id @default(uuid())
  institutionId           String
  institutionType         InstitutionType
  generationScope         String          @default("CLASS")
  changeRoomEveryLecture  Boolean         @default(false)
  selectedClassName       String?
  selectedAcademicLevelId String?
  selectedSectionId       String?
  subjectWeeklyLectures   Json?
  updatedByUserId         String?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, institutionType])
}
model TeacherSubject {
  id         String @id @default(uuid())
  teacherId  String
  subjectId  String

  teacher    Teacher @relation(fields: [teacherId], references: [id])
  subject    Subject @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, subjectId])
}

